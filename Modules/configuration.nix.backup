{ config, pkgs, ... }:

{
  imports = [
    ./hardware-configuration.nix
  ];

  #################################
  # Boot - Gaming Optimizations
  #################################
  boot = {
    loader = {
      systemd-boot.enable = true;
      efi.canTouchEfiVariables = true;
    };
    
    # Latest kernel for best gaming performance
    kernelPackages = pkgs.linuxPackages_latest;
    
    # Gaming kernel parameters optimized for Precision 5560
    kernelParams = [
      "mitigations=off"  # Disable CPU mitigations for better performance
      "nowatchdog"       # Disable watchdog
      "split_lock_detect=off"
      "nvidia-drm.modeset=1"  # Required for Wayland
      "acpi_rev_override=1"   # Dell ACPI quirk
    ];
    
    # Precision 5560 specific: Load NVIDIA modules early
    initrd.kernelModules = [ "nvidia" "nvidia_modeset" "nvidia_uvm" "nvidia_drm" ];
    
    kernel.sysctl = {
      # Network optimizations
      "net.core.netdev_max_backlog" = 16384;
      "net.core.somaxconn" = 8192;
      "net.core.rmem_default" = 1048576;
      "net.core.rmem_max" = 16777216;
      "net.core.wmem_default" = 1048576;
      "net.core.wmem_max" = 16777216;
      "net.ipv4.tcp_fastopen" = 3;
      "net.ipv4.tcp_congestion_control" = "bbr";
      "net.ipv4.tcp_mtu_probing" = 1;
      
      # Virtual memory tweaks
      "vm.max_map_count" = 2147483642;
      "vm.swappiness" = 10;
    };
  };

  #################################
  # Networking
  #################################
  networking = {
    hostName = "nixos";
    networkmanager.enable = true;
    # Enable Intel WiFi 6 AX201 optimizations
    wireless.iwd.enable = false; # Use NetworkManager instead
  };

  #################################
  # Time & Locale
  #################################
  time.timeZone = "Europe/London";
  
  i18n = {
    defaultLocale = "en_GB.UTF-8";
    extraLocaleSettings = {
      LC_ADDRESS = "en_GB.UTF-8";
      LC_IDENTIFICATION = "en_GB.UTF-8";
      LC_MEASUREMENT = "en_GB.UTF-8";
      LC_MONETARY = "en_GB.UTF-8";
      LC_NAME = "en_GB.UTF-8";
      LC_NUMERIC = "en_GB.UTF-8";
      LC_PAPER = "en_GB.UTF-8";
      LC_TELEPHONE = "en_GB.UTF-8";
      LC_TIME = "en_GB.UTF-8";
    };
  };

  #################################
  # Keyboard
  #################################
  services.xserver.xkb = {
    layout = "gb";
  };
  console.keyMap = "uk";

  #################################
  # Display / Login - SDDM Silent Theme
  #################################
  services.xserver.enable = true;
  
  # Keep KDE Plasma (optional fallback)
  services.desktopManager.plasma6.enable = true;
  
  # SDDM with Silent theme (configured in sddm-theme.nix)
  services.displayManager.sddm = {
    enable = true;
    wayland.enable = true;
    package = pkgs.kdePackages.sddm;
  };

  #################################
  # Hyprland with Gaming Optimizations
  #################################
  programs.hyprland = {
    enable = true;
    xwayland.enable = true;
  };

  #################################
  # Flatpak
  #################################
  services.flatpak.enable = true;

  #################################
  # Printing
  #################################
  services.printing.enable = true;

  #################################
  # Power Management - Dell Precision 5560 Specific
  #################################
  services.power-profiles-daemon.enable = false;
  
  # Use TLP instead for Dell laptops - better battery + performance balance
  services.tlp = {
    enable = true;
    settings = {
      # Performance on AC, balanced on battery
      CPU_SCALING_GOVERNOR_ON_AC = "performance";
      CPU_SCALING_GOVERNOR_ON_BAT = "powersave";
      
      # CPU boost
      CPU_BOOST_ON_AC = 1;
      CPU_BOOST_ON_BAT = 0;
      
      # Turbo boost
      CPU_HWP_DYN_BOOST_ON_AC = 1;
      CPU_HWP_DYN_BOOST_ON_BAT = 0;
      
      # Dell-specific optimizations
      PLATFORM_PROFILE_ON_AC = "performance";
      PLATFORM_PROFILE_ON_BAT = "balanced";
      
      # NVIDIA handling for gaming
      RUNTIME_PM_ON_AC = "on";
      RUNTIME_PM_ON_BAT = "auto";
      
      # PCI devices - keep NVIDIA active on AC
      RUNTIME_PM_DRIVER_BLACKLIST = "nvidia";
      
      # USB autosuspend delay for gaming peripherals
      USB_AUTOSUSPEND = 0;
    };
  };
  
  # Thermald for Intel thermal management
  services.thermald.enable = true;

  #################################
  # Audio - Low Latency Setup for Precision 5560
  #################################
  security.rtkit.enable = true;
  services.pipewire = {
    enable = true;
    alsa.enable = true;
    alsa.support32Bit = true;
    pulse.enable = true;
    wireplumber.enable = true;
    
    # Low latency configuration for gaming
    extraConfig.pipewire = {
      "10-gaming" = {
        "context.properties" = {
          "default.clock.rate" = 48000;
          "default.clock.quantum" = 256;
          "default.clock.min-quantum" = 256;
        };
      };
    };
  };

  #################################
  # Graphics - NVIDIA RTX A2000 / T1200 Optimized
  #################################
  hardware.graphics = {
    enable = true;
    enable32Bit = true;  # Essential for 32-bit games
    
    extraPackages = with pkgs; [
      intel-media-driver  # LIBVA_DRIVER_NAME=iHD
      vaapiIntel         # LIBVA_DRIVER_NAME=i965 (older but sometimes more stable)
      vaapiVdpau
      libvdpau-va-gl
      intel-compute-runtime # OpenCL
    ];
  };
  
  # Use only NVIDIA driver for Precision 5560
  services.xserver.videoDrivers = [ "nvidia" ];
  
  # NVIDIA configuration for Quadro RTX A2000 / T1200
  hardware.nvidia = {
    # Use proprietary drivers for gaming (open driver doesn't support RTX A2000 fully yet)
    open = false;
    
    modesetting.enable = true;
    
    # Enable NVIDIA Settings
    nvidiaSettings = true;
    
    # Precision 5560 uses PRIME Render Offload (not sync)
    # All display outputs go through Intel, NVIDIA is for compute/gaming
    prime = {
      offload = {
        enable = true;
        enableOffloadCmd = true;
      };
      
      # These Bus IDs are typical for Precision 5560
      # Verify with: sudo lspci | grep -E "VGA|3D"
      intelBusId = "PCI:0:2:0";
      nvidiaBusId = "PCI:1:0:0";
    };
    
    # Power management
    powerManagement = {
      enable = true;
      finegrained = true;  # RTX A2000 supports dynamic power management
    };
    
    # Use latest stable drivers
    package = config.boot.kernelPackages.nvidiaPackages.stable;
  };

  # Environment variables for NVIDIA + Wayland on Precision 5560
  environment.sessionVariables = {
    # Wayland
    WLR_NO_HARDWARE_CURSORS = "1";
    NIXOS_OZONE_WL = "1";
    
    # NVIDIA specific
    LIBVA_DRIVER_NAME = "nvidia";
    GBM_BACKEND = "nvidia-drm";
    __GLX_VENDOR_LIBRARY_NAME = "nvidia";
    
    # Gaming optimizations
    __GL_SHADER_DISK_CACHE = "1";
    __GL_SHADER_DISK_CACHE_SKIP_CLEANUP = "1";
    __GL_THREADED_OPTIMIZATION = "1";
    
    # Quadro/RTX specific
    __GL_SYNC_TO_VBLANK = "0";  # Better for gaming
    __GL_YIELD = "USLEEP";
    
    # Vulkan
    VK_ICD_FILENAMES = "/run/opengl-driver/share/vulkan/icd.d/nvidia_icd.x86_64.json";
  };

  #################################
  # User with Gaming Groups
  #################################
  users.users.exvexityl = {
    isNormalUser = true;
    extraGroups = [ 
      "wheel" 
      "networkmanager" 
      "video" 
      "audio"
      "input"
      "gamemode"
    ];
    initialPassword = "123800";  # CHANGE THIS AFTER FIRST LOGIN!
  };

  #################################
  # Programs - Gaming Focus
  #################################
  programs.firefox.enable = true;
  
  # Steam with all gaming optimizations
  programs.steam = {
    enable = true;
    remotePlay.openFirewall = true;
    dedicatedServer.openFirewall = true;
    gamescopeSession.enable = true;
    
    # Enable Proton compatibility
    extest.enable = true;
  };
  
  # Gamemode for automatic performance optimizations
  programs.gamemode = {
    enable = true;
    settings = {
      general = {
        renice = 10;
      };
      gpu = {
        apply_gpu_optimisations = "accept-responsibility";
        gpu_device = 0;
        nv_powermizer_mode = 1;  # Prefer maximum performance for NVIDIA
      };
      custom = {
        start = "${pkgs.libnotify}/bin/notify-send 'GameMode started'";
        end = "${pkgs.libnotify}/bin/notify-send 'GameMode ended'";
      };
    };
  };

  #################################
  # System Packages - Gaming + Tools
  #################################
  environment.systemPackages = with pkgs; [
    # Basic tools
    wget
    curl
    git
    micro
    fastfetch
    
    # File managers
    nautilus
    dolphin
    
    # Gaming tools
    mangohud
    goverlay
    gamemode
    gamescope
    protonup-qt
    wine
    winetricks
    lutris
    heroic
    bottles  # Windows app runner
    
    # Performance monitoring
    btop
    nvtopPackages.full
    
    # Brightness control (Precision 5560)
    brightnessctl
    
    # Hyprland essentials
    hyprland
    kitty
    foot
    rofi-wayland
    
    # Wayland tools
    grim
    slurp
    wl-clipboard
    cliphist
    wl-screenrec
    
    # Notification daemon
    mako
    libnotify
    
    # Portal
    xdg-desktop-portal-hyprland
    xdg-desktop-portal-gtk
    
    # Qt/GTK support
    qt6.qtwayland
    qt5.qtwayland
    adwaita-qt
    adwaita-qt6
    
    # Audio control
    pavucontrol
    playerctl
    
    # Network
    networkmanagerapplet
    
    # Power management GUI
    powertop
    
    # Dell utilities
    fwupd  # Firmware updates
  ];

  #################################
  # Fonts for Noctalia
  #################################
  fonts.packages = with pkgs; [
    noto-fonts
    noto-fonts-emoji
    noto-fonts-cjk-sans
    roboto
    inter
    liberation_ttf
    (nerdfonts.override { fonts = [ "FiraCode" "JetBrainsMono" "Hack" ]; })
  ];

  #################################
  # Services
  #################################
  # Firmware updates
  services.fwupd.enable = true;
  
  # Bluetooth (Precision 5560 has Intel AX201)
  hardware.bluetooth = {
    enable = true;
    powerOnBoot = true;
    settings = {
      General = {
        Enable = "Source,Sink,Media,Socket";
        Experimental = true;
      };
    };
  };
  services.blueman.enable = true;

  #################################
  # Nix Settings
  #################################
  nix.settings = {
    experimental-features = [ "nix-command" "flakes" ];
    auto-optimise-store = true;
    
    # Substituters for faster builds
    substituters = [
      "https://cache.nixos.org"
      "https://nix-community.cachix.org"
    ];
    trusted-public-keys = [
      "cache.nixos.org-1:6NCHdD59X431o0gWypbMrAURkbJ16ZPMQFGspcDShjY="
      "nix-community.cachix.org-1:mB9FSh9qf2dCimDSUo8Zy7bkq5CX+/rkCWyvRCYg3Fs="
    ];
  };
  
  nixpkgs.config = {
    allowUnfree = true;
    
    # Enable hardware acceleration
    packageOverrides = pkgs: {
      vaapiIntel = pkgs.vaapiIntel.override { enableHybridCodec = true; };
    };
  };
  
  # Automatic garbage collection
  nix.gc = {
    automatic = true;
    dates = "weekly";
    options = "--delete-older-than 7d";
  };

  #################################
  # Firewall for Gaming
  #################################
  networking.firewall = {
    enable = true;
    allowedTCPPorts = [ ];
    allowedUDPPorts = [ ];
  };

  #################################
  # Security & Performance
  #################################
  # Enable RealtimeKit for low-latency audio
  security.rtkit.enable = true;
  
  # Polkit for GUI apps
  security.polkit.enable = true;
  
  # AppArmor disabled for gaming (can cause issues)
  security.apparmor.enable = false;

  #################################
  # State Version
  #################################
  system.stateVersion = "25.05";
}
